# SMTP settings used by the contact form's API route (app/api/contact/route.js)
# For Gmail: use smtp.gmail.com, port 587, and a 16-character "App Password"
# (NOT your normal Gmail password — generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification enabled on your Google account first).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
CONTACT_TO_EMAIL=youraddress@gmail.com
